# Copy this file to .env and fill in your values.

# ---- Django ----
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Needed when served over HTTPS on your own domain, e.g. https://shop.example.co.ke
DJANGO_CSRF_TRUSTED_ORIGINS=

# ---- Database (PostgreSQL). Leave DB_NAME empty to fall back to local SQLite for quick tests ----
DB_NAME=liquorpos
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# ---- Store details (printed on receipts) ----
STORE_NAME=Your Liquor Store
STORE_ADDRESS=Ongata Rongai, Kajiado
STORE_PHONE=0700 000 000
STORE_KRA_PIN=
STORE_LIQUOR_LICENCE=

# ---- M-Pesa (Safaricom Daraja) ----
# sandbox | production
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Sandbox values below are Safaricom's public test shortcode/passkey. Replace for production.
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
# Paybill: CustomerPayBillOnline   |   Till (Buy Goods): CustomerBuyGoodsOnline
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Paybill: leave empty (uses shortcode).  Till: put your Till number here and put the Store/Head-office number in MPESA_SHORTCODE.
MPESA_PARTY_B=
# Public HTTPS address Safaricom can reach (no trailing slash). In development use ngrok or cloudflared.
MPESA_CALLBACK_BASE_URL=https://your-public-url.example.com
# Random string that forms part of the callback URL so strangers cannot post fake payments.
MPESA_CALLBACK_SECRET=change-me-random-string
# Offline demo mode: no Safaricom calls; STK pushes "succeed" after ~15 seconds. NEVER use in production.
MPESA_SIMULATE=False
